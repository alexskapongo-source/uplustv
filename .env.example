# ============================================================
#  Univers+ — variables d'environnement
# ------------------------------------------------------------
#  En local    : copier ce fichier en .env.local
#  Sur Netlify : Site configuration > Environment variables
#
#  Aucune valeur secrete ne doit etre prefixee NEXT_PUBLIC_ :
#  ce prefixe expose la valeur dans le JavaScript du navigateur.
# ============================================================


# --- Site -----------------------------------------------------
# URL publique, utilisee pour les canonicals, le sitemap et
# OpenGraph. Sur Netlify, mettre le domaine definitif.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Administration (/admin) ---------------------------------
# OBLIGATOIRES. Si l'une des deux manque, l'acces est REFUSE
# (et non ouvert). Generer le secret avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=


# --- Paiement -------------------------------------------------
# Tant qu'aucun identifiant marchand n'est renseigne, le tunnel
# fonctionne en mode demonstration : la transaction est simulee
# cote serveur et l'interface l'indique au visiteur.
PAYMENT_PROVIDER=demo

AIRTEL_MONEY_CLIENT_ID=
AIRTEL_MONEY_CLIENT_SECRET=
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
CARD_GATEWAY_SECRET_KEY=


# --- Contact --------------------------------------------------
# Publiques par nature : elles s'affichent sur le site.
# Tant qu'elles sont vides, le canal concerne n'est pas propose
# plutot que d'afficher un numero qui ne repond pas.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_EMAIL=


# --- Stockage -------------------------------------------------
# Aucune variable a definir : sur Netlify, les souscriptions,
# commandes et messages sont ecrits dans Netlify Blobs, active
# automatiquement. En local, ils vont dans /data (ignore par git).
